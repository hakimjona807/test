# GEMINI_API_KEY: Gemini AI API kaliti (ixtiyoriy, qo'shimcha tahlil uchun).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Platformaning asosiy URL manzili.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Ixtiyoriy):
# Agar Supabase bulutli ma'lumotlar bazasini ulamoqchi bo'lsangiz:
# 1. supabase.com dan loyiha oching
# 2. Project Settings -> API bo'limidan quyidagi kalitlarni ko'chiring:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
# Eslatma: Agar Supabase ulanmagan bo'lsa, platforma avtomatik tarzda
# to'liq xavfsiz va tezkor mahalliy doimiy ma'lumotlar ombori (Local Storage & State Engine) orqali ishlaydi.

# TELEGRAM BOT INTEGRATION (Ixtiyoriy):
# Test natijalarini o'qituvchiga yoki o'quvchiga avtomatik yuborish uchun:
# 1. Telegramda @BotFather orqali yangi bot yarating va bot tokenini oling
# 2. @userinfobot orqali chat ID oling
VITE_TELEGRAM_BOT_TOKEN=""
VITE_TELEGRAM_CHAT_ID=""

